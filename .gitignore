# docs/sessions/ is deliberately COMMITTED, not ignored. The session protocol in
# CLAUDE.md requires a new session to start by reading the newest note, and that only
# works if the notes survive a clone. To keep them local instead, add: docs/sessions/

# Secrets
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# SQLite audit log
*.db
*.sqlite3

# Generated data — everything except the frozen demo set (§11.10)
data/generated/*
!data/generated/demo/
