# Gemini — Layer 2 investigator. Get a free key at https://aistudio.google.com/apikey
# Free-tier rate limits: https://aistudio.google.com/rate-limit
GEMINI_API_KEY=

# Razorpay test mode — optional. Without these, Closo runs fully on synthetic data.
RZP_KEY_ID=
RZP_KEY_SECRET=

# 1 = no network calls at all, fixed seed 42, replay enabled. Leave at 1 for demos.
DEMO_MODE=1
